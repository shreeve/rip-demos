# App uses exports from medical-tests.rip (loaded first)

component App
  searchTerm := ''
  selectedTests := new Set()
  totals ~= calculateTotals(selectedTests)
  filteredTests ~= if searchTerm is '' then medicalTests else medicalTests.filter (t) => t.name.toLowerCase().includes(searchTerm.toLowerCase()) or t.code.toLowerCase().includes(searchTerm.toLowerCase())

  handleSearch: (e) ->
    searchTerm = e.target.value

  onListClick: (e) ->
    (selectedTests = handleItemClick(e, selectedTests) or selectedTests) and requestAnimationFrame(() => requestAnimationFrame(() => updateListItemClasses(@_root, selectedTests)))

  mounted: ->
    @_root.querySelector('.listWrapper')?.addEventListener('click', (e) => @onListClick(e)) or requestAnimationFrame(() => updateListItemClasses(@_root, selectedTests))

  render
    .("h-screen flex flex-col items-center justify-center p-4")
      .("card w-full max-w-3xl flex flex-col h-[40rem] max-h-[90vh]")

        # Header
        .("card-header shrink-0 z-10")
          .("flex justify-between items-center mb-6")
            .("flex items-center gap-3")
              .logo "LO"
              div
                h1.("text-lg font-semibold tracking-tight leading-tight") "New Order"
                p.("text-xs text-secondary mt-0.5") "Select tests for patient #89201"
            button.("p-2 hover:bg-gray-50 rounded-lg text-muted hover:text-secondary transition-colors") "⋯"

          # Search
          .("search-input-wrapper")
            span.("search-icon text-muted") "🔍"
            input.("search-input") type: "text", placeholder: "Search by test name or code...", autocomplete: "off", @input: @handleSearch

        # List (click handler added via mounted)
        .("listWrapper flex-1 overflow-hidden")
          .("card-body h-full relative overflow-auto")
            .("w-full pb-2")
              for test in filteredTests
                .("list-item cursor-pointer")
                  div data_id: test.id, ""
                  .("flex items-center gap-4 overflow-hidden")
                    .checkbox
                      span.("checkbox-icon")
                    .("flex flex-col min-w-0")
                      .("flex items-center gap-2 mb-0.5")
                        span.badge test.code
                      span.("text-sm font-medium truncate pr-4") test.name
                  .("flex flex-col items-end gap-0.5 whitespace-nowrap pl-4")
                    span.("price-current") formatCurrency(test.discount)
                    span.("price-original") formatCurrency(test.retail)

            # Empty State
            .("empty-state")
              .("empty-state-icon") "🧪"
              h3.("empty-state-title") "No matching tests"
              p.("empty-state-description") "Try adjusting your search terms."

        # Footer
        .("card-footer shrink-0 z-20")
          .("flex flex-col gap-4")
            .("space-y-2")
              .("flex justify-between text-xs text-secondary font-medium")
                span "Selected Tests"
                span "#{totals.count} #{pluralize(totals.count, 'item')}"
              .("flex justify-between text-xs text-secondary font-medium")
                span "Retail Value"
                span.("line-through text-muted") style: (if totals.count > 0 then "opacity:1" else "opacity:0.5"), formatCurrency(totals.retail)
              .("flex justify-between items-center pt-3 border-t border-gray-200/60")
                span.("text-sm font-semibold") "Total"
                span.("text-lg font-semibold tracking-tight") formatCurrency(totals.discount)

            button.("btn btn-primary w-full group")
              span "Create Order"
              span.("btn-icon") "→"

App.new().mount "#app"
