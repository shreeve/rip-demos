# App uses exports from medical-tests.rip (loaded first)

component App
  searchTerm := ''
  selectedTests := new Set()
  totals ~= calculateTotals(selectedTests)

  handleSearch: (e) ->
    searchTerm = e.target.value

  render
    .("h-screen flex flex-col items-center justify-center p-4")
      .("card w-full max-w-3xl flex flex-col")
        .("card-header p-6")
          h1.("text-lg font-semibold") "Lab Orders"
          input.("search-input mt-4") type: "text", placeholder: "Search...", @input: @handleSearch

        .("card-body overflow-auto p-4")
          for test in medicalTests
            .("list-item p-4 border-b")
              .("flex justify-between")
                div
                  span.badge test.code
                  span.("ml-2") test.name
                div
                  span formatCurrency(test.discount)

        .("card-footer p-4")
          .("flex justify-between")
            span "Total"
            span formatCurrency(totals.discount)
          button.("btn btn-primary w-full mt-4") "Create Order"

App.new().mount "#app"
